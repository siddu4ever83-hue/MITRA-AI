<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/editorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/colorPrimary"
            app:titleTextColor="@color/white"/>

    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/toolbarBackground"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:padding="4dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btn_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="B"
                    android:textStyle="bold"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_italic"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="I"
                    android:textStyle="italic"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_strike"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="S"
                    style="@style/FormatTextButton"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_margin="4dp"/>

                <Button
                    android:id="@+id/btn_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="H1"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_h2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="H2"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_h3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="H3"
                    style="@style/FormatTextButton"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_margin="4dp"/>

                <Button
                    android:id="@+id/btn_code"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="&lt;/&gt;"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_code_block"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="```"
                    style="@style/FormatTextButton"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_margin="4dp"/>

                <Button
                    android:id="@+id/btn_link"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="URL"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_image"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="IMG"
                    style="@style/FormatTextButton"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_margin="4dp"/>

                <Button
                    android:id="@+id/btn_list"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="• List"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_ordered_list"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="1. List"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_checkbox"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="☑"
                    style="@style/FormatTextButton"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="30dp"
                    android:background="@color/divider"
                    android:layout_margin="4dp"/>

                <Button
                    android:id="@+id/btn_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="❝"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_hr"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="---"
                    style="@style/FormatTextButton"/>

                <Button
                    android:id="@+id/btn_table"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Table"
                    style="@style/FormatTextButton"/>

            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/edit_markdown"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="16dp"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:background="@color/editorBackground"
            android:textColor="@color/editorText"
            android:hint="@string/editor_hint"
            android:textColorHint="@color/divider"
            android:scrollbars="vertical"/>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
