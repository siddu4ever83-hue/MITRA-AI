<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MITRAAI" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/editorBackground</item>
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:navigationBarColor">@color/colorPrimaryDark</item>
    </style>

    <style name="FormatButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">8dp</item>
        <item name="android:tint">@color/buttonTint</item>
        <item name="android:layout_margin">2dp</item>
    </style>

    <style name="FormatTextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/buttonTint</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
</resources>
